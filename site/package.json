{
  "name": "site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "data:build": "node ../scripts/build-site-data.mjs --source .. --out public/data",
    "data:fixtures": "node ../scripts/build-site-data.mjs --source ./fixtures --out public/data",
    "dev": "npm run data:build && vite",
    "dev:fixtures": "npm run data:fixtures && vite",
    "build": "npm run data:build && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "fuse.js": "^7.5.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
